# Ghostty — 주 터미널. 창을 띄우면 바로 tmux 로 들어간다.
#
# 원래 WezTerm 설정을 옮겨 온 것이라 아래 주석에 "WezTerm 에는 없던" 같은
# 비교가 남아 있다. 왜 이 값인지에 대한 근거라 남겨 두지만, WezTerm 자체는
# 2026-08 에 제거됐다 (wezterm/ 디렉토리·Brewfile cask 모두 없음).
#
# 리로드: Cmd+Shift+, (아래 keybind 로 직접 정의함)  설정 열기: ghostty +edit-config
# 테마 목록: ghostty +list-themes
#
# 설계: 레이아웃·세션은 전부 tmux 담당. 이 파일은 터미널 자체(폰트·색·IME·
#       이미지 프로토콜)와 tmux 로 키를 넘기는 얇은 계층만 다룬다.

# ── tmux 자동 시작 ────────────────────────────────────────
# WezTerm: default_prog = { tmux, new-session, -A, -s, main }
command = /opt/homebrew/bin/tmux new-session -A -s main

# ── SSH / 원격 (최우선) ───────────────────────────────────
# TERM=xterm-ghostty 가 원격에 없어 tmux 가 "missing or unsuitable terminal"
# 로 죽는 것을 막는다. ssh-terminfo 가 원격에 terminfo 를 설치해 준다.
shell-integration = zsh
shell-integration-features = sudo,ssh-terminfo,ssh-env

# ── 폰트 ──────────────────────────────────────────────────
# 2026-08-28: FiraCode → JetBrainsMono. x-height 가 높고 글자폭이 일정해
# 작은 크기에서도 덜 뭉갠다. Nerd Font 변형이라 상태줄 아이콘이 그대로 나온다.
# 여러 번 선언하면 앞에서부터 폴백된다.
#   +list-fonts 로 확인한 정확한 이름이 "JetBrainsMono Nerd Font Mono" 다.
#   "JetBrains Mono"(Nerd 아님)와 다른 폰트이니 이름을 줄이면 안 된다.
font-family = JetBrainsMono Nerd Font Mono
font-family = Apple Color Emoji
font-size = 14
# Retina 에서 글자가 얇게 보이는 것 보정
font-thicken = true
# 행간 — 가독성·인상 차이가 가장 큰 값. 0% 가 기본
adjust-cell-height = 15%
window-title-font-family = JetBrainsMono Nerd Font Mono

# 한글은 D2Coding 으로 (코드포인트 범위 지정 — WezTerm 보다 정밀함)
font-codepoint-map = U+AC00-U+D7A3,U+1100-U+11FF,U+3130-U+318F=D2CodingLigature Nerd Font

# ── 색 ────────────────────────────────────────────────────
# 2026-08-28: Dracula → Catppuccin Mocha. 팔레트 22줄을 직접 쓰던 것을
# Ghostty 내장 테마로 대체한다(+list-themes 에서 확인). 색 정의가 한 곳으로
# 모여서 tmux/theme.conf 와 어긋날 여지가 줄었다.
theme = Catppuccin Mocha

# ── 윈도우 ────────────────────────────────────────────────
# WezTerm 은 window_decorations="RESIZE" 로 타이틀바를 완전히 없앴지만,
# Ghostty 는 타이틀바 색까지 지정할 수 있어 남겨두는 편이 낫다.
#   native / transparent / tabs / hidden 중 선택
#   - native: macOS 기본 타이틀바. 자체 배경·하단 경계를 그려서 본문과 확실히 갈린다
#   - transparent: 배경과 어우러짐 — 경계를 "일부러 없애는" 스타일
#   - tabs: 탭이 타이틀바에 통합 (Safari 스타일) — Ghostty 탭을 쓸 때
#   - hidden: 완전히 없음
#
# 2026-08-26: transparent → native. 타이틀바와 본문이 구분이 안 된다는 요청.
# transparent 는 타이틀바를 터미널 배경색에 맞춰 따라가게 하는 스타일이라
# 구조적으로 경계가 안 생긴다. native 는 macOS 가 직접 그리므로 경계가 남는다.
#
# [주의] 문서상 "런타임 변경은 새 창에만 적용"된다. ⌘⇧, 리로드만으로는
#        기존 창이 안 바뀌고, 새 창을 열거나 Ghostty 를 재시작해야 한다.
# [대가] 아래 window-titlebar-background/foreground 로 맞춘 Dracula 색은
#        native 에서 macOS 가 그리는 부분에 안 먹을 수 있다.
macos-titlebar-style = native

# 창 크롬(타이틀바 등)을 터미널 색에서 가져온다. 직접 지정한 아래 두 값보다
# 우선하지 않고, 시스템 다크/라이트 대신 터미널 팔레트를 따르게 하는 옵션.
window-theme = ghostty

# 타이틀바 색 — macos-titlebar-style = native 에서는 macOS 가 직접 그려서
# 안 먹을 수 있다. transparent 로 되돌릴 때를 위해 Catppuccin 값으로 맞춰 둔다.
window-titlebar-background = #181825
window-titlebar-foreground = #a6adc8

# 타이틀바에 현재 작업 디렉토리를 부제로 표시
window-subtitle = working-directory

# 내용이 창 안에 떠 있는 느낌. 4 는 너무 빡빡했다.
window-padding-x = 12
# 세로 패딩 0 (2026-08-26) — tmux 상태바를 창 위/아래 가장자리에 딱 붙이려는 것.
# Ghostty 는 패딩을 그리드 전체에 적용하므로 상태바만 따로 뺄 수 없다.
# 즉 이 값을 올리면 본문뿐 아니라 상태바도 같이 뜬다. 가로(x)는 바의 위치와
# 무관하고 본문 가독성에 필요해서 12 로 남긴다.
window-padding-y = 0
window-padding-balance = true
window-inherit-working-directory = true

# 리사이즈 시 패딩도 배경색으로 채워 빈틈이 안 보이게
window-padding-color = extend

# 넓은 색역 — 2560x1600 디스플레이에서 색이 더 정확하게 나온다
window-colorspace = display-p3

# ── 반투명 · 블러 (WezTerm 에는 블러가 아예 없다) ─────────
background-opacity = 0.95
background-blur = 30

# ── 가독성 ────────────────────────────────────────────────
# 창을 반투명하게 하면 글자가 얇고 흐리게 보인다. native 는 OS 기본 합성이라
# 배경이 비칠 때 획이 뭉개진다. linear-corrected 는 선형 색공간에서 합성한 뒤
# 보정해 반투명 배경 위에서도 획 두께가 유지된다.
alpha-blending = linear-corrected

# 배경 대비 명암비 하한. 기본 1 은 "강제하지 않음".
# Catppuccin 의 주석색(overlay0 #6c7086)이 배경(base #1e1e2e) 위에서 흐린 편인데,
# 이 값을 올리면 그런 저대비 글자만 자동으로 밝아진다. 팔레트 전체를
# 바꾸지 않고 안 보이는 것만 끌어올리는 방식.
# 1.0=끄기 / 1.5=은은 / 3=뚜렷 / 21=최대(팔레트가 뭉개짐)
minimum-contrast = 1.5

# ── 앱 아이콘 (Dock·Cmd+Tab 에 보이는 것) ─────────────────
# official / blueprint / chalkboard / microchip / glass / holographic
#   / paper / retro / xray
# frame: aluminum / beige / plastic / chrome
macos-icon = retro
macos-icon-frame = aluminum

# ── 동작 ──────────────────────────────────────────────────
macos-option-as-alt = true
link-url = true
mouse-hide-while-typing = true

# 스크롤 감도 (2026-08-26 — "너무 빠르다"). 기본값은 precision:1,discrete:3.
#   precision = 트랙패드 두 손가락, discrete = 휠 마우스 한 칸. 범위 0.01~10000.
#
# 중요: Claude Code·nvim 처럼 alternate screen + 마우스 리포팅을 쓰는 TUI 안에서는
# tmux 가 휠을 그대로 앱에 넘긴다(send-keys -M). 즉 tmux.reset.conf 의
# copy-mode -N 값은 그쪽에 안 먹고, 이 배수만이 유일한 조절 수단이다.
# (tmux -N 은 셸 스크롤백처럼 alternate screen 이 아닌 pane 에만 적용된다.)
#
# 실측으로 맞춘 값 — 1=너무 빠름, 0.2=아직 빠른 편, 0.05=과하게 느림,
# 0.1=아주 조금 느림 → 0.13 으로 확정. discrete 는 같은 비율로 맞췄다.
# 조절하려면 이 값만 고치고 ⌘⇧, 로 리로드하면 바로 반영된다.
mouse-scroll-multiplier = precision:0.13,discrete:0.65
# 1.3.1 은 scrollback-limit (바이트). main 브랜치는 -lines/-bytes 로 분리됐으므로
# 나중에 업그레이드하면 이름이 바뀔 수 있다. 기본값은 10000000.
scrollback-limit = 10000000
confirm-close-surface = false

# ══════════════════════════════════════════════════════════
# 키바인딩
# ══════════════════════════════════════════════════════════
# WezTerm 의 disable_default_key_bindings = true 에 해당
keybind = clear

# ── Quick Terminal — 화면 위에서 내려오는 드롭다운 터미널 ─
# WezTerm 에는 없는 기능. global: 접두사로 앱이 비활성일 때도 동작한다.
# tmux 세션과 별개로 잠깐 명령 하나 칠 때 쓴다.
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ── 앱 레벨 (터미널이 직접 처리) ──────────────────────────
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+n=new_window
# 설정 리로드. keybind = clear 가 기본 바인딩을 전부 지우므로 직접 넣어야 한다
# (2026-08-26: 없는 줄 모르고 ⌘⇧, 를 눌러 왔다 — 아무 동작도 안 하고 있었다).
keybind = cmd+shift+comma=reload_config
keybind = cmd+shift+equal=increase_font_size:1
keybind = cmd+shift+minus=decrease_font_size:1
keybind = cmd+digit_0=reset_font_size

# ── tmux 패스스루 ─────────────────────────────────────────
# \x02 = Ctrl+B (tmux prefix). WezTerm 의 SendString 과 같은 방식.
# 실제 동작은 전부 .tmux.conf / tmux.reset.conf 가 정의한다.

# window 이동
keybind = cmd+digit_1=text:\x021
keybind = cmd+digit_2=text:\x022
keybind = cmd+digit_3=text:\x023
keybind = cmd+digit_4=text:\x024
keybind = cmd+digit_5=text:\x025

# window 생성/닫기, 이전·다음
# 왼쪽 사이드바 토글 (VS Code 관례에 맞춰 Cmd+B) → tmux prefix+B
keybind = cmd+b=text:\x02B

keybind = cmd+t=text:\x02c
keybind = cmd+w=text:\x02x
keybind = cmd+bracket_left=text:\x02H
keybind = cmd+bracket_right=text:\x02L

# 분할 — tmux.reset.conf 의 `bind s split-window -v` 는 .tmux.conf 의
# `bind s display-popup`(세션 선택)이 나중에 덮으므로, 위아래 분할은 prefix+| 를 쓴다.
keybind = cmd+shift+d=text:\x02|
keybind = cmd+shift+e=text:\x02v

# pane 이동 — 방향키와 hjkl 둘 다
keybind = cmd+arrow_left=text:\x02h
keybind = cmd+arrow_right=text:\x02l
keybind = cmd+arrow_up=text:\x02k
keybind = cmd+arrow_down=text:\x02j
keybind = cmd+h=text:\x02h
keybind = cmd+l=text:\x02l
keybind = cmd+k=text:\x02k
keybind = cmd+j=text:\x02j

# pane 크기 조절
keybind = ctrl+shift+arrow_left=text:\x02,
keybind = ctrl+shift+arrow_right=text:\x02.
keybind = ctrl+shift+arrow_up=text:\x02=
keybind = ctrl+shift+arrow_down=text:\x02-

# 레이아웃 균등 · zoom
keybind = cmd+equal=text:\x02e
keybind = cmd+minus=text:\x02E

# 페이지 스크롤 — tmux 의 prefix+_ / prefix++ 로 넘긴다.
# 그쪽에서 copy-mode 진입과 페이지 이동을 한 번에 처리한다(tmux.reset.conf).
# ctrl+- / ctrl+= 는 표준 제어문자가 없어 터미널마다 인코딩이 다르므로,
# 그대로 흘려보내지 않고 여기서 prefix 시퀀스로 바꿔 보낸다.
# VSCode 의 터미널 페이지 스크롤과 같은 키로 맞췄다.
keybind = ctrl+minus=text:\x02_
keybind = ctrl+equal=text:\x02+
keybind = cmd+z=text:\x02z

# 팝업·선택기
keybind = ctrl+backslash=text:\x02g
keybind = ctrl+slash=text:\x02w
keybind = ctrl+comma=text:\x02s
keybind = cmd+shift+n=text:\x02S
keybind = cmd+p=text:\x02p
keybind = cmd+f=text:\x02f

# ── 옮기지 못한 것 ────────────────────────────────────────
# 1. Ctrl+1 / Ctrl+2 세션 전환 (WezTerm: background_child_process)
#    Ghostty 에는 외부 명령 실행 액션이 없다 → .tmux.conf 로 옮겼다:
#      bind -n C-1 run-shell "~/.config/tmux/scripts/session-switch.sh main"
#
# 2. Cmd+Shift+B 배경 이미지 토글 (WezTerm: set_config_overrides)
#    Ghostty 에는 런타임 설정 변경 API 가 없다. background-image 는 고정.
#    (원본 WezTerm 설정의 이미지 경로 ~/LJJ/dotfiles/dotfiles/b.jpg 는
#     파일이 존재하지 않아 이미 동작하지 않던 상태였다)
