# Ghostty — 주 터미널. (원래 WezTerm 설정을 옮겨 온 것이라 아래 주석에
# "WezTerm 에는 없던" 같은 비교가 남아 있다. WezTerm 은 2026-08-25 에 제거됐다.)
#
# 리로드: Cmd+Shift+,        설정 열기: ghostty +edit-config
# 테마 목록: ghostty +list-themes
#
# 설계: 레이아웃·세션은 전부 herdr 담당(2026-08-24, tmux 에서 이행). 이 파일은
#       터미널 자체(폰트·색·IME·이미지 프로토콜)와 herdr 로 키를 넘기는 얇은 계층만 다룬다.

# ── 시작 프로그램 ─────────────────────────────────────────
# tmux 자동 시작은 제거(2026-08-24) — herdr 로 이행. 자동 실행 대신 단축키
# ⌘⇧H 로 herdr 를 띄운다(사용자 결정: "바로 실행되는거 말고 단축키 등록").
# 세션 유지는 herdr server 가 담당하므로 창을 닫아도 작업은 살아있다.

# ── SSH / 원격 (최우선) ───────────────────────────────────
# TERM=xterm-ghostty 가 원격에 없어 원격 TUI 가 "missing or unsuitable
# terminal" 로 죽는 것을 막는다. ssh-terminfo 가 원격에 terminfo 를 설치해 준다.
# (.zshrc 의 `alias ssh='TERM=xterm-256color ssh'` 가 2차 안전망.)
shell-integration = zsh
shell-integration-features = sudo,ssh-terminfo,ssh-env

# ── 폰트 ──────────────────────────────────────────────────
# WezTerm: font_with_fallback{FiraCode NF, MesloLGS NF, Symbols NF, Apple Color Emoji}
# 여러 번 선언하면 앞에서부터 폴백된다.
font-family = FiraCode Nerd Font
font-family = MesloLGS NF
font-family = Apple Color Emoji
# WezTerm 설정에 있던 "Symbols Nerd Font" 는 이 머신에 미설치라 뺐다.
# FiraCode Nerd Font 가 이미 Nerd 글리프를 포함하므로 실질 손실 없음.
font-size = 15
# Retina 에서 글자가 얇게 보이는 것 보정
font-thicken = true
# 행간 — 가독성·인상 차이가 가장 큰 값. 0% 가 기본
adjust-cell-height = 12%
# 타이틀바 폰트도 지정 가능 (WezTerm 에는 없던 옵션)
window-title-font-family = FiraCode Nerd Font

# 한글은 D2Coding 으로 (코드포인트 범위 지정 — WezTerm 보다 정밀함)
font-codepoint-map = U+AC00-U+D7A3,U+1100-U+11FF,U+3130-U+318F=D2CodingLigature Nerd Font

# ── 색 (Dracula 공식 팔레트 — WezTerm 설정과 동일한 값) ───
# theme = Dracula 로도 되지만, 기존 값과 100% 동일하게 하려고 직접 지정.
background = #282a36
foreground = #f8f8f2
cursor-color = #f8f8f2
cursor-text = #282a36
selection-background = #44475a
selection-foreground = #f8f8f2

palette = 0=#21222c
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff

# ── 윈도우 ────────────────────────────────────────────────
# WezTerm 은 window_decorations="RESIZE" 로 타이틀바를 완전히 없앴지만,
# Ghostty 는 타이틀바 색까지 지정할 수 있어 남겨두는 편이 낫다.
#   native / transparent / tabs / hidden 중 선택
#   - transparent: 배경과 어우러짐 (탭을 herdr 로 쓰므로 이게 맞음)
#   - tabs: 탭이 타이틀바에 통합 (Safari 스타일) — Ghostty 탭을 쓸 때
#   - hidden: 완전히 없음 (WezTerm 과 동일하게 하려면 이것)
macos-titlebar-style = transparent

# 창 크롬(타이틀바 등)을 터미널 색에서 가져온다. 직접 지정한 아래 두 값보다
# 우선하지 않고, 시스템 다크/라이트 대신 터미널 팔레트를 따르게 하는 옵션.
window-theme = ghostty

# 타이틀바를 Dracula 팔레트에 맞춤 (WezTerm 에는 없던 기능)
window-titlebar-background = #21222c
window-titlebar-foreground = #6272a4

# 타이틀바에 현재 작업 디렉토리를 부제로 표시
window-subtitle = working-directory

# 내용이 창 안에 떠 있는 느낌. 4 는 너무 빡빡했다.
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-inherit-working-directory = true

# 리사이즈 시 패딩도 배경색으로 채워 빈틈이 안 보이게
window-padding-color = extend

# 넓은 색역 — 2560x1600 디스플레이에서 Dracula 색이 더 정확하게 나온다
window-colorspace = display-p3

# ── 반투명 · 블러 (WezTerm 에는 블러가 아예 없다) ─────────
background-opacity = 0.95
background-blur = 30

# ── 가독성 ────────────────────────────────────────────────
# 창을 반투명하게 하면 글자가 얇고 흐리게 보인다. native 는 OS 기본 합성이라
# 배경이 비칠 때 획이 뭉개진다. linear-corrected 는 선형 색공간에서 합성한 뒤
# 보정해 반투명 배경 위에서도 획 두께가 유지된다.
alpha-blending = linear-corrected

# 배경 대비 명암비 하한. 기본 1 은 "강제하지 않음".
# Dracula 의 주석색(#6272a4)이 배경(#282a36) 위에서 흐린 편인데,
# 이 값을 올리면 그런 저대비 글자만 자동으로 밝아진다. 팔레트 전체를
# 바꾸지 않고 안 보이는 것만 끌어올리는 방식.
# 1.0=끄기 / 1.5=은은 / 3=뚜렷 / 21=최대(팔레트가 뭉개짐)
minimum-contrast = 1.5

# ── 앱 아이콘 (Dock·Cmd+Tab 에 보이는 것) ─────────────────
# official / blueprint / chalkboard / microchip / glass / holographic
#   / paper / retro / xray
# frame: aluminum / beige / plastic / chrome
macos-icon = retro
macos-icon-frame = aluminum

# ── 동작 ──────────────────────────────────────────────────
macos-option-as-alt = true
link-url = true
mouse-hide-while-typing = true
# 1.3.1 은 scrollback-limit (바이트). main 브랜치는 -lines/-bytes 로 분리됐으므로
# 나중에 업그레이드하면 이름이 바뀔 수 있다. 기본값은 10000000.
scrollback-limit = 10000000
confirm-close-surface = false

# ══════════════════════════════════════════════════════════
# 키바인딩
# ══════════════════════════════════════════════════════════
# WezTerm 의 disable_default_key_bindings = true 에 해당
keybind = clear

# ── Quick Terminal — 화면 위에서 내려오는 드롭다운 터미널 ─
# WezTerm 에는 없는 기능. global: 접두사로 앱이 비활성일 때도 동작한다.
# herdr 세션과 별개로 잠깐 명령 하나 칠 때 쓴다.
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ── 앱 레벨 (터미널이 직접 처리) ──────────────────────────
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+n=new_window
keybind = cmd+shift+equal=increase_font_size:1
keybind = cmd+shift+minus=decrease_font_size:1
keybind = cmd+digit_0=reset_font_size

# ── herdr 실행 ────────────────────────────────────────────
# Ghostty 에는 외부 명령 실행 액션이 없어(아래 '옮기지 못한 것' 1번과 같은 제약)
# text: 로 셸에 명령을 타이핑한다. \x15 = Ctrl+U — 입력 중이던 줄을 지우고 실행.
keybind = cmd+shift+h=text:\x15herdr\n

# ── herdr 패스스루 ────────────────────────────────────────
# \x02 = Ctrl+B (herdr prefix — tmux 와 같은 값이라 시퀀스만 바꾸면 됐다).
# 실제 동작은 herdr 기본 키맵(herdr --skill 로 확인, v0.8.2). herdr 가 안 떠 있는
# 맨 셸에서는 \x02 가 커서 한 칸 뒤로일 뿐이라 무해하다.

# tab 직행 (herdr: switch_tab = prefix+1..9)
keybind = cmd+digit_1=text:\x021
keybind = cmd+digit_2=text:\x022
keybind = cmd+digit_3=text:\x023
keybind = cmd+digit_4=text:\x024
keybind = cmd+digit_5=text:\x025

# 사이드바 토글 (herdr: toggle_sidebar = prefix+b. tmux 시절 커스텀 B 와 달리 소문자)
keybind = cmd+b=text:\x02b

# tab 생성/이전·다음 (herdr: new_tab=c, previous_tab=p, next_tab=n)
keybind = cmd+t=text:\x02c
# cmd+w 는 close_pane(prefix+x) 이다 — tab 통째로 닫는 건 close_tab(prefix+shift+x).
# 마지막 pane 을 닫으면 결과적으로 tab 도 닫히므로 실사용 감각은 tmux 와 같다.
keybind = cmd+w=text:\x02x
keybind = cmd+bracket_left=text:\x02p
keybind = cmd+bracket_right=text:\x02n

# 분할 (herdr: split_horizontal=minus 가 아래로, split_vertical=v 가 옆으로)
keybind = cmd+shift+d=text:\x02-
keybind = cmd+shift+e=text:\x02v

# pane 이동 — 방향키와 hjkl 둘 다 (herdr: focus_pane_h/j/k/l — tmux 와 동일)
keybind = cmd+arrow_left=text:\x02h
keybind = cmd+arrow_right=text:\x02l
keybind = cmd+arrow_up=text:\x02k
keybind = cmd+arrow_down=text:\x02j
keybind = cmd+h=text:\x02h
keybind = cmd+l=text:\x02l
keybind = cmd+k=text:\x02k
keybind = cmd+j=text:\x02j

# pane 크기 조절 — 리사이즈 모드 진입 (모드 안에서 hjkl/방향키, esc 로 종료).
# 방향별 즉시 조절은 herdr/config.toml 의 resize_pane_* 에 ctrl+shift+방향 으로
# 걸어 뒀다(tmux 시절과 동일). ghostty 는 keybind = clear 라 그 조합을 가로채지
# 않고 그대로 herdr 로 흘려보내므로 여기에 따로 바인딩할 것이 없다.
keybind = cmd+r=text:\x02r

# zoom (herdr: zoom = prefix+z — tmux 와 동일)
keybind = cmd+z=text:\x02z

# 팝업·선택기 (herdr: goto=g, workspace_picker=w, settings=s, new_workspace=shift+n)
keybind = cmd+p=text:\x02g
keybind = ctrl+backslash=text:\x02g
keybind = ctrl+slash=text:\x02w
keybind = ctrl+comma=text:\x02s
keybind = cmd+shift+n=text:\x02N

# ── tmux 시절에서 승계하지 않은 것 ────────────────────────
# cmd+= / cmd+- 레이아웃 균등:  herdr 에 대응 동작이 없다
# cmd+f 검색:                   herdr 에 검색 바인딩이 없다 (스크롤백은 prefix+e 로
#                               에디터에 열어 검색하는 방식)
# ctrl+1/2 세션 전환:           tmux 세션 개념이 사라짐 — herdr 워크스페이스 피커(⌃/)로
#
# 되찾은 것: ctrl+shift+방향 크기조절 — herdr/config.toml 의 resize_pane_* 로 복원.

# ── 짝이 되는 설정 파일 ───────────────────────────────────
# herdr/config.toml 이 prefix = "ctrl+b" 를 고정한다. 위 \x02 패스스루가 전부
# 그 값을 전제하므로, prefix 를 바꾸려면 두 파일을 함께 고쳐야 한다.
