{
  "window.newWindowDimensions": "inherit",
  "window.nativeFullScreen": true,
  "window.titleBarStyle": "custom",  // Title Bar는 유지

  // ========== Workbench ==========
  // "workbench.editor.showTabs": "none",
  "workbench.editor.showTabs": "multiple",  // 또는 "multiple"
  // Tab 크기 조절

  "workbench.startupEditor": "none",
  "workbench.sideBar.location": "left",
  // "workbench.tree.indent": 7,
  "workbench.tree.enableStickyScroll": false,
  // "workbench.secondarySideBar.defaultVisibility": "hidden",
  // "workbench.editor.editorActionsLocation": "hidden",
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.list.smoothScrolling": true,


  // ========== Editor ==========
  "editor.fontSize": 14,
  // "editor.contextmenu": false,
  // "editor.lineHeight": 20,
  // "editor.fontFamily": "Monaspace",
  "editor.cursorSurroundingLines": 15,  // 위아래 10줄 유지
  "editor.cursorSurroundingLinesStyle": "all",  // 항상 적용
  "editor.hover.enabled": "on",
  "editor.hover.delay": 500,
  "editor.fontWeight": "400",
  "editor.fontLigatures": false,
  "editor.cursorBlinking": "solid",
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
  "editor.padding.top": 7,
  "editor.mouseWheelZoom": true,
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.tabCompletion": "on",

  // // ========== Editor - UI Elements ==========
  // "editor.lineNumbers": "off",
  "editor.minimap.enabled": false,
  "editor.glyphMargin": false,
  "editor.showFoldingControls": "never",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.stickyScroll.enabled": false,
  "breadcrumbs.enabled": false,

  // ========== Editor - Guides & Decorations ==========
  // "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.colorDecorators": true,
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,


  // ========== Editor - Behavior ==========
  "editor.linkedEditing": true,
  // "editor.formatOnSave": true,
  // "editor.formatOnPaste": true,
  // "editor.copyWithSyntaxHighlighting": false,
  // "editor.emptySelectionClipboard": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.acceptSuggestionOnEnter": "smart",
  // "editor.scrollbar.vertical": "hidden",
  // "editor.scrollbar.horizontal": "hidden"
  // "editor.accessibilitySupport": "off",
  "editor.snippetSuggestions": "top",
  "editor.suggestSelection": "first",
  "editor.suggestFontSize": 16,
  "editor.suggestLineHeight": 30,
  "editor.inlineSuggest.suppressSuggestions": false,
  // "editor.quickSuggestions": {
  //     "other": true,
  //     "comments": true,
  //     "strings": true
  // },
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.selectionHighlight": true,
  "editor.occurrencesHighlight": "off",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  // ========== Editor - Token Colors ==========
  "editor.tokenColorCustomizations": {
      "textMateRules": [
          {
              "scope": [
                  "comment",
                  "keyword",
                  "variable.language",
                  "entity.other.attribute-name.html",
                  "entity.other.attribute-name",
                  "keyword.control",
                  "storage.type",
                  "comment.block",
                  "comment.line"
              ],
              "settings": {
                  "fontStyle": ""
              }
          }
      ]
  },

  // // ========== Files ==========
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "afterDelay",

  // // ========== Explorer ==========
  "explorer.sortOrder": "default",
  "explorer.confirmDragAndDrop": false,
  // "explorer.confirmDelete": false,
  // "explorer.compactFolders": true,
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,
  "problems.decorations.enabled": true,

  // ========== Terminal ==========
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.tabs.location": "right",

  // // ========== Git ==========
  // "git.autofetch": true,
  // "git.enableSmartCommit": true,
  // "git.confirmSync": true,
  // "git.replaceTagsWhenPull": true,
  // "git.openRepositoryInParentFolders": "always",
  "git.decorations.enabled": true,
  "scm.diffDecorations": "all",

  // // ========== GitHub ==========
  // "githubPullRequests.createOnPublishBranch": "never",
  // "githubPullRequests.pullBranch": "never",

  // // ========== GitLens ==========
  // "gitlens.hovers.currentLine.over": "line",

  // 인라인 제안 — Copilot 전용이 아니라 코어 설정이라 남긴다.
  "editor.inlineSuggest.enabled": true,

  // "material-icon-theme.files.color": "#42a5f5",

  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "terminal.integrated.smoothScrolling": true,

  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#1e1e2e",
    "editor.background": "#1e1e2e",
    "terminal.background": "#1e1e2e",
    "panel.background": "#1e1e2e",
    "statusBar.background": "#1e1e2e",
    "sideBar.background": "#1e1e2e",
    "sideBar.border": "#1e1e2e00",  // 투명
    "editorGroupHeader.noTabsBackground": "#1e1e2e",
    "editorGroup.border": "#1e1e2e00",  // 투명
    "sideBarSectionHeader.border": "#1e1e2e00",  // 투명
    // "editorGroup.border": "#1e1e2e",
    "editorGroupHeader.tabsBackground": "#1e1e2e",
    "statusBarItem.remoteBackground": "#1e1e2e",  // Remote 배경

    // "editorIndentGuide.background": "#1e1e2e",  // 거의 안 보이게


    "editorBracketHighlight.foreground": "#f5c2e7",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#1e1e2e",

    // Tab 색상 조정
    "tab.activeBackground": "#1e1e2e",  // Active도 같은 색
    "tab.inactiveBackground": "#1e1e2e",
    "tab.activeForeground": "#cdd6f4",  // Active - 밝게
    "tab.inactiveForeground": "#6c7086",  // Inactive - 어둡게
    "tab.hoverBackground": "#313244",  // 살짝만
    "tab.hoverForeground": "#cdd6f4",
    "tab.activeModifiedBorder": "#f38ba8",  // Red
    "tab.inactiveModifiedBorder": "#6c7086",  // 어두운 회색
    "tab.border": "#1e1e2e",
    "tab.activeBorder": "#1e1e2e",
    "tab.activeBorderTop": "#1e1e2e",
    "tab.hoverBorder": "#1e1e2e",
      // Tab에서 Git badge 색상은 여기로!
    "badge.foreground": "#ddd782",  // Badge 텍스트 (숫자)

    // 또는 전역 Git decoration 색상
    "gitDecoration.modifiedResourceForeground": "#6c7086",
    "gitDecoration.untrackedResourceForeground": "#6c7086",
    "gitDecoration.deletedResourceForeground": "#6c7086",
    "gitDecoration.conflictingResourceForeground": "#6c7086",
    "gitDecoration.ignoredResourceForeground": "#6c708650",


    "statusBar.debuggingBackground": "#28684a",
    "statusBar.noFolderBackground": "#38386b",
    "editor.lineHighlightBackground": "#404346",
    "editor.lineHighlightBorder": "#404346",
    "editor.selectionBackground": "#2f4d50",
    "editorLineNumber.foreground": "#00000000",  // 투명
    // "editorLineNumber.activeForeground": "#bd93f9",

    "editorLineNumber.activeForeground": "#f9e2af",
    "editorSuggestWidget.selectedBackground": "#45475a",  // Surface1
    "editorSuggestWidget.focusHighlightForeground": "#f38ba8",
    "editorSuggestWidget.selectedIconForeground": "#f38ba8",  // Blue



    "statusBarItem.remoteForeground": "#cdd6f4",
    "statusBar.foreground": "#cdd6f4",
    "editorIndentGuide.activeBackground1": "#cba6f7",

    "scrollbarSlider.background": "#585b7040",  // Surface2 + alpha
    "scrollbarSlider.hoverBackground": "#585b7080",  // 호버시 더 진하게
    "scrollbarSlider.activeBackground": "#585b70cc",  // 클릭시 가장 진하게
    "editorOverviewRuler.background": "#1e1e2e00",  // 투명
    "editorOverviewRuler.border": "#1e1e2e00",  // 투명

    // Git decorations 숨기기

    // Status Bar 세밀화
    "statusBarItem.activeBackground": "#1e1e2e",
    "statusBarItem.hoverBackground": "#313244",

    // Notifications
    "notifications.background": "#1e1e2e",
    "notifications.border": "#313244",

    // Input/Dropdown
    "input.background": "#1e1e2e",
    "input.border": "#313244",
    "dropdown.background": "#1e1e2e",
    "dropdown.border": "#313244",
    "list.hoverBackground": "#313244",
    "list.activeSelectionBackground": "#313244",

    // Command Palette
    "quickInput.background": "#1e1e2e",
    "quickInput.foreground": "#cdd6f4",
    "quickInputList.focusBackground": "#313244",
  },

  "database-client.autoSync": true,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.editorActionsLocation": "hidden",
  "chat.commandCenter.enabled": false,
  "workbench.editor.tabActionCloseVisibility": false,
  "git.enableSmartCommit": true,
  "claudeCode.preferredLocation": "sidebar",
  "git.confirmSync": false,
  "workbench.activityBar.location": "bottom",
  "githubPullRequests.createOnPublishBranch": "never",
  "redhat.telemetry.enabled": true,
  "window.confirmSaveUntitledWorkspace": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "chat.titleBar.openInAgentsWindow.enabled": false
}
